{
  "name": "dsh-plugin-iot-thinking",
  "version": "0.1.0",
  "description": "IoT thinking-block compression for DeepSeek Harness: rewrite the reasoning block inside llm/stream before the assistant message is committed, so the model sees the compact block in place (no compaction checkpoint).",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "iot"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
