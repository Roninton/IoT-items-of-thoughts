{
  "name": "dsh-plugin-iot-thinking",
  "version": "0.2.0",
  "description": "IoT (Items of Thoughts) for DeepSeek Harness: rewrite the reasoning block inside llm/stream before the assistant message is committed. The rewrite is chosen per session / per agent preset from a strategy registry (decision nodes, long-range research, in-character voice), with no compaction checkpoint.",
  "type": "module",
  "main": "dsh-plugin-iot-thinking/index.mjs",
  "exports": {
    ".": "./dsh-plugin-iot-thinking/index.mjs",
    "./client": "./dsh-plugin-iot-thinking/lib/client.js",
    "./package.json": "./dsh-plugin-iot-thinking/package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin-iot-thinking/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dsh-plugin-iot-thinking/index.mjs",
    "dsh-plugin-iot-thinking/lib/",
    "dsh-plugin-iot-thinking/cordis.patch.yml",
    "dsh-plugin-iot-thinking/package.json",
    "dsh-plugin-iot-thinking/README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roninton/IoT-items-of-thoughts.git"
  }
}
